  "src": {
   "type": "file",
   "file": "index.html",
   "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Glass App v2</title>\n<style>\n*{box-sizing:border-box}\n:root{--bg:#e6e9ef;--tx:#111;--mut:#555;--card:#e6e9ef;--sh1:#c3c9d6;--sh2:#fff;--glass:rgba(255,255,255,.55)}\nbody.dark{--bg:#0b0e14;--tx:#fff;--mut:#aab4c5;--card:rgba(255,255,255,.07);--sh1:#000;--sh2:rgba(255,255,255,.08);--glass:rgba(255,255,255,.07)}\nbody{margin:0;font-family:system-ui,sans-serif;background:var(--bg);color:var(--tx);display:flex;min-height:100vh;transition:background .3s,color .3s}\n.sidebar{width:72px;flex-shrink:0;background:var(--glass);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border-right:1px solid rgba(128,128,128,.25);padding:16px 10px;transition:width .3s;display:flex;flex-direction:column;gap:6px}\n.sidebar.open{width:230px}\n.toggle{align-self:flex-end;background:var(--card);color:var(--tx);border:1px solid #8885;border-radius:50%;width:32px;height:32px;cursor:pointer;box-shadow:3px 3px 8px var(--sh1),-3px -3px 8px var(--sh2)}\n.logo{font-weight:800;letter-spacing:1px;padding:10px 12px;white-space:nowrap;overflow:hidden}\n.item{display:flex;align-items:center;gap:12px;padding:12px;border-radius:14px;border:0;background:transparent;color:var(--tx);font-size:16px;text-align:left;cursor:pointer;white-space:nowrap;overflow:hidden}\n.item:hover,.item.active{background:rgba(128,128,128,.18)}\n.item .ic{font-size:20px;min-width:28px;text-align:center}\n.item .lbl{display:none}\n.sidebar.open .item .lbl{display:inline}\n.badge{margin-left:auto;background:#111;color:#fff;border-radius:20px;padding:2px 8px;font-size:12px}\nbody.dark .badge{background:#fff;color:#111}\nmain{flex:1;padding:22px;max-width:720px}\nh1{font-size:26px;margin:6px 0}\np{color:var(--mut);line-height:1.6}\n.card{background:var(--card);border-radius:20px;padding:20px;margin:16px 0;box-shadow:7px 7px 16px var(--sh1),-7px -7px 16px var(--sh2)}\nbody.dark .card{border:1px solid rgba(255,255,255,.12);backdrop-filter:blur(18px)}\nbutton{border:0;border-radius:14px;padding:12px 20px;font-size:16px;margin:6px 6px 6px 0;background:#fff;color:#111;cursor:pointer;box-shadow:4px 4px 10px var(--sh1),-4px -4px 10px var(--sh2)}\nbody.dark button{background:rgba(255,255,255,.12);color:#fff;box-shadow:none;border:1px solid rgba(255,255,255,.2)}\nbutton.black{background:#111;color:#fff}\nbody.dark button.black{background:#fff;color:#111}\n.page{display:none}\n.page.active{display:block}\n#n{font-size:44px;margin:6px 0}\n.small{font-size:13px;color:var(--mut)}\n/* Dark mode switch - black and white only */\n.switch{display:flex;align-items:center;gap:12px}\n.track{width:110px;height:52px;border-radius:30px;background:#fff;box-shadow:inset 3px 3px 8px #c3c9d6,inset -3px -3px 8px #fff;position:relative;cursor:pointer;flex-shrink:0}\nbody.dark .track{background:#222;box-shadow:inset 3px 3px 8px #000,inset -3px -3px 8px rgba(255,255,255,.1)}\n.knob{position:absolute;top:6px;left:6px;width:40px;height:40px;border-radius:50%;background:#fff;box-shadow:3px 3px 8px #aaa;display:flex;align-items:center;justify-content:center;font-size:20px;transition:left .35s}\nbody.dark .knob{left:64px;background:#111;color:#fff;box-shadow:3px 3px 8px #000}\n</style>\n</head>\n<body>\n<nav class=\"sidebar\" id=\"side\">\n<button class=\"toggle\" onclick=\"document.getElementById('side').classList.toggle('open')\">\u203a</button>\n<div class=\"logo\">GLASS</div>\n<button class=\"item active\" onclick=\"show('home',this)\"><span class=\"ic\">\u2302</span><span class=\"lbl\">Home</span></button>\n<button class=\"item\" onclick=\"show('post',this)\"><span class=\"ic\">\u270e</span><span class=\"lbl\">Post</span></button>\n<button class=\"item\" onclick=\"show('messages',this)\"><span class=\"ic\">\u2709</span><span class=\"lbl\">Messages</span><span class=\"badge\">2</span></button>\n<button class=\"item\" onclick=\"show('friends',this)\"><span class=\"ic\">\ud83d\udc65</span><span class=\"lbl\">Friends</span></button>\n<button class=\"item\" onclick=\"show('notifications',this)\"><span class=\"ic\">\ud83d\udd14</span><span class=\"lbl\">Notifications</span></button>\n<button class=\"item\" onclick=\"show('group',this)\"><span class=\"ic\">\ud83d\udc6a</span><span class=\"lbl\">Group</span></button>\n<button class=\"item\" onclick=\"show('pages',this)\"><span class=\"ic\">\u25a4</span><span class=\"lbl\">Pages</span></button>\n<button class=\"item\" onclick=\"show('games',this)\"><span class=\"ic\">\ud83c\udfae</span><span class=\"lbl\">Games</span></button>\n<button class=\"item\" onclick=\"show('setting',this)\"><span class=\"ic\">\u2699</span><span class=\"lbl\">Setting</span></button>\n<button class=\"item\" onclick=\"alert('Logged out - demo only')\"><span class=\"ic\">\u23fb</span><span class=\"lbl\">Log Out</span></button>\n</nav>\n<main>\n<section class=\"page active\" id=\"home\">\n<h1>Glass App v2</h1>\n<p>Liquid Glass + Neumorphism, in black and white only. No colours. Light mode is soft neumorphism. Dark mode is frosted glass.</p>\n<div class=\"card switch\">\n<div class=\"track\" onclick=\"document.body.classList.toggle('dark');document.getElementById('knob').textContent=document.body.classList.contains('dark')?'\u263e':'\u2600'\"><div class=\"knob\" id=\"knob\">\u2600</div></div>\n<div><b>Dark Mode switch</b><p class=\"small\" style=\"margin:4px 0\">Tap the switch. Sun = light, Moon = dark. Same app, same menu, only the theme changes.</p></div>\n</div>\n<div class=\"card\">\n<div id=\"n\">0</div>\n<button class=\"black\" onclick=\"document.getElementById('n').textContent=+document.getElementById('n').textContent+1\">+1 Tap me</button>\n<button onclick=\"toast('Hello from Glass App v2')\">Say Hello</button>\n<button onclick=\"vib()\">Vibrate</button>\n<button onclick=\"share('Hello from Glass App v2')\">Share</button>\n</div>\n<div class=\"card\">\n<b>Test a function</b>\n<p class=\"small\">These use the real app bridge when installed as an APK, and a simple alert in a browser.</p>\n<button onclick=\"notifyMe()\">Notify me</button>\n<button onclick=\"speakMe()\">Speak this</button>\n<button onclick=\"saveMe()\">Save a note</button>\n</div>\n</section>\n<section class=\"page\" id=\"post\"><h1>Post</h1><p>Write a short post here in the full version.</p></section>\n<section class=\"page\" id=\"messages\"><h1>Messages</h1><p>You have 2 new messages in this demo.</p></section>\n<section class=\"page\" id=\"friends\"><h1>Friends</h1><p>Your friends list will appear here.</p></section>\n<section class=\"page\" id=\"notifications\"><h1>Notifications</h1><p>Tap Notify me on Home to test a real notification in the APK.</p></section>\n<section class=\"page\" id=\"group\"><h1>Group</h1><p>Your groups will appear here.</p></section>\n<section class=\"page\" id=\"pages\"><h1>Pages</h1><p>Your pages will appear here.</p></section>\n<section class=\"page\" id=\"games\"><h1>Games</h1><p>A simple counter game is on Home.</p></section>\n<section class=\"page\" id=\"setting\"><h1>Setting</h1><p>Black and white only. Light = neumorphism, Dark = liquid glass. No extra colours, no clutter.</p></section>\n</main>\n<script>\nfunction show(id,btn){\n document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));\n document.getElementById(id).classList.add('active');\n document.querySelectorAll('.item').forEach(b=>b.classList.remove('active'));\n if(btn) btn.classList.add('active');\n}\nfunction toast(m){ if(window.Android&&Android.toast){Android.toast(m)}else{alert(m)} }\nfunction vib(){ if(window.Android&&Android.vibrate){Android.vibrate(100)}else{alert('Vibrate works only in the real APK')} }\nfunction share(t){ if(window.Android&&Android.share){Android.share(t)}else{alert('Share: '+t)} }\nfunction notifyMe(){ if(window.Android&&Android.notify){Android.notify('Glass App v2','Hello, this is a test notification')}else{alert('Notification works only in the real APK')} }\nfunction speakMe(){ if(window.Android&&Android.speak){Android.speak('Welcome to Glass App version two')}else{alert('Text to speech works only in the real APK')} }\nfunction saveMe(){ if(window.Android&&Android.saveFile){alert(Android.saveFile('glass-note.txt','text/plain','Hello from Glass App v2'))}else{alert('File save works only in the real APK')} }\n</script>\n</body>\n</html>\n"
  },
