   "type": "file",
   "file": "index.html",
   "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Glass App</title>\n<style>\n*{box-sizing:border-box}\nbody{margin:0;font-family:system-ui,sans-serif;background:#0b0e14;color:#fff;display:flex;min-height:100vh}\n.sidebar{width:72px;flex-shrink:0;background:rgba(255,255,255,.07);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border-right:1px solid rgba(255,255,255,.15);padding:16px 10px;transition:width .3s;display:flex;flex-direction:column;gap:6px}\n.sidebar.open{width:230px}\n.logo{font-weight:800;letter-spacing:1px;padding:10px 12px;white-space:nowrap;overflow:hidden}\n.logo span{color:#80b0ec}\n.toggle{align-self:flex-end;background:rgba(255,255,255,.12);color:#fff;border:1px solid rgba(255,255,255,.2);border-radius:50%;width:32px;height:32px;cursor:pointer}\n.item{display:flex;align-items:center;gap:12px;padding:12px;border-radius:14px;border:0;background:transparent;color:#dbe2ee;font-size:16px;text-align:left;cursor:pointer;white-space:nowrap;overflow:hidden}\n.item:hover,.item.active{background:rgba(255,255,255,.12)}\n.item .ic{font-size:20px;min-width:28px;text-align:center}\n.item .lbl{display:none}\n.sidebar.open .item .lbl{display:inline}\n.badge{margin-left:auto;background:#0249e1;color:#fff;border-radius:20px;padding:2px 8px;font-size:12px}\nmain{flex:1;padding:22px;max-width:720px}\nh1{font-size:26px;margin:6px 0}\np{color:#aab4c5;line-height:1.6}\n.card{background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);border-radius:20px;padding:20px;margin:16px 0}\nbutton{border:0;border-radius:14px;padding:12px 20px;font-size:16px;margin:6px 6px 6px 0;background:#fff;color:#111;cursor:pointer}\nbutton.blue{background:#0249e1;color:#fff}\nbutton.ghost{background:transparent;color:#fff;border:1px solid rgba(255,255,255,.25)}\n.page{display:none}\n.page.active{display:block}\n#n{font-size:44px;margin:6px 0}\n.small{font-size:13px;color:#8a94a6}\n</style>\n</head>\n<body>\n<nav class=\"sidebar\" id=\"side\">\n<button class=\"toggle\" onclick=\"document.getElementById('side').classList.toggle('open')\">\u203a</button>\n<div class=\"logo\">G<span>LASS</span></div>\n<button class=\"item active\" onclick=\"show('home',this)\"><span class=\"ic\">\u2302</span><span class=\"lbl\">Home</span></button>\n<button class=\"item\" onclick=\"show('post',this)\"><span class=\"ic\">\u270e</span><span class=\"lbl\">Post</span></button>\n<button class=\"item\" onclick=\"show('messages',this)\"><span class=\"ic\">\u2709</span><span class=\"lbl\">Messages</span><span class=\"badge\">2</span></button>\n<button class=\"item\" onclick=\"show('friends',this)\"><span class=\"ic\">\ud83d\udc65</span><span class=\"lbl\">Friends</span></button>\n<button class=\"item\" onclick=\"show('notifications',this)\"><span class=\"ic\">\ud83d\udd14</span><span class=\"lbl\">Notifications</span></button>\n<button class=\"item\" onclick=\"show('group',this)\"><span class=\"ic\">\ud83d\udc6a</span><span class=\"lbl\">Group</span></button>\n<button class=\"item\" onclick=\"show('pages',this)\"><span class=\"ic\">\u25a4</span><span class=\"lbl\">Pages</span></button>\n<button class=\"item\" onclick=\"show('games',this)\"><span class=\"ic\">\ud83c\udfae</span><span class=\"lbl\">Games</span></button>\n<button class=\"item\" onclick=\"show('setting',this)\"><span class=\"ic\">\u2699</span><span class=\"lbl\">Setting</span></button>\n<button class=\"item\" onclick=\"alert('Logged out - demo only')\"><span class=\"ic\">\u23fb</span><span class=\"lbl\">Log Out</span></button>\n</nav>\n<main>\n<section class=\"page active\" id=\"home\">\n<h1>Welcome</h1>\n<p>Minimal, dark, glass design. No rainbow colours. One accent only. Tap the arrow on the sidebar to open or close it.</p>\n<div class=\"card\">\n<div id=\"n\">0</div>\n<button class=\"blue\" onclick=\"document.getElementById('n').textContent=+document.getElementById('n').textContent+1\">+1 Tap me</button>\n<button onclick=\"toast('Hello from Glass App')\">Say Hello</button>\n<button onclick=\"vib()\">Vibrate</button>\n<button class=\"ghost\" onclick=\"share('Hello from Glass App')\">Share</button>\n</div>\n<div class=\"card\">\n<b>Test a function</b>\n<p class=\"small\">These use the real app bridge when installed as an APK, and a simple alert when opened in a browser.</p>\n<button onclick=\"notifyMe()\">Notify me</button>\n<button onclick=\"speakMe()\">Speak this</button>\n<button onclick=\"saveMe()\">Save a note</button>\n</div>\n</section>\n<section class=\"page\" id=\"post\"><h1>Post</h1><p>Write a short post here in the full version. This page is a clean placeholder, so the menu works.</p></section>\n<section class=\"page\" id=\"messages\"><h1>Messages</h1><p>You have 2 new messages in this demo. In a real app, these would come from your data, not from a demo.</p></section>\n<section class=\"page\" id=\"friends\"><h1>Friends</h1><p>Your friends list will appear here.</p></section>\n<section class=\"page\" id=\"notifications\"><h1>Notifications</h1><p>Tap Notify me on Home to test a real notification in the APK.</p></section>\n<section class=\"page\" id=\"group\"><h1>Group</h1><p>Your groups will appear here.</p></section>\n<section class=\"page\" id=\"pages\"><h1>Pages</h1><p>Your pages will appear here.</p></section>\n<section class=\"page\" id=\"games\"><h1>Games</h1><p>A simple counter game is on Home. More games can be added as separate pages.</p></section>\n<section class=\"page\" id=\"setting\"><h1>Setting</h1><p>Dark, minimal, glass. No extra colours, no clutter. That is the design rule for this app.</p></section>\n</main>\n<script>\nfunction show(id,btn){\n document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));\n document.getElementById(id).classList.add('active');\n document.querySelectorAll('.item').forEach(b=>b.classList.remove('active'));\n if(btn) btn.classList.add('active');\n}\nfunction toast(m){ if(window.Android&&Android.toast){Android.toast(m)}else{alert(m)} }\nfunction vib(){ if(window.Android&&Android.vibrate){Android.vibrate(100)}else{alert('Vibrate works only in the real APK')} }\nfunction share(t){ if(window.Android&&Android.share){Android.share(t)}else{alert('Share: '+t)} }\nfunction notifyMe(){ if(window.Android&&Android.notify){Android.notify('Glass App','Hello, this is a test notification')}else{alert('Notification works only in the real APK')} }\nfunction speakMe(){ if(window.Android&&Android.speak){Android.speak('Welcome to Glass App')}else{alert('Text to speech works only in the real APK')} }\nfunction saveMe(){ if(window.Android&&Android.saveFile){alert(Android.saveFile('glass-note.txt','text/plain','Hello from Glass App'))}else{alert('File save works only in the real APK')} }\n</script>\n</body>\n</html>\n"
  },
