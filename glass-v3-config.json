  "src": {
   "type": "file",
   "file": "index.html",
   "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Glass App v3 - Shocking</title>\n<style>\n*{box-sizing:border-box}\nbody{margin:0;font-family:system-ui,sans-serif;background:#e6e9ef;color:#111;display:flex;min-height:100vh}\nbody.dark{background:#0a0a0a;color:#fff}\n/* SIDEBAR FIX: Light mode = solid white, strong shadow, black icons. Dark mode = glass. */\n.sidebar{width:76px;flex-shrink:0;background:#ffffff;padding:16px 10px;display:flex;flex-direction:column;gap:8px;box-shadow:10px 0 30px rgba(0,0,0,.12);transition:width .35s}\nbody.dark .sidebar{background:rgba(255,255,255,.07);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border-right:1px solid rgba(255,255,255,.15);box-shadow:none}\n.sidebar.open{width:240px}\n.toggle{align-self:flex-end;background:#111;color:#fff;border:0;border-radius:50%;width:36px;height:36px;cursor:pointer;font-size:18px}\nbody.dark .toggle{background:#fff;color:#111}\n.logo{font-weight:900;letter-spacing:2px;padding:12px;font-size:20px;white-space:nowrap;overflow:hidden}\n.item{display:flex;align-items:center;gap:12px;padding:13px;border-radius:16px;border:0;background:transparent;color:#111;font-size:16px;text-align:left;cursor:pointer;white-space:nowrap;overflow:hidden;transition:all .2s}\nbody.dark .item{color:#fff}\n.item:hover{transform:translateX(3px)}\n.item.active{background:#111;color:#fff}\nbody.dark .item.active{background:#fff;color:#111}\n.item .ic{font-size:20px;min-width:28px;text-align:center}\n.item .lbl{display:none}\n.sidebar.open .item .lbl{display:inline}\n.badge{margin-left:auto;background:#111;color:#fff;border-radius:20px;padding:2px 8px;font-size:12px}\nbody.dark .badge{background:#fff;color:#111}\nmain{flex:1;padding:24px;max-width:760px}\n.hero{font-size:52px;line-height:.95;font-weight:900;letter-spacing:-1px;margin:10px 0;animation:rise .6s ease}\n.hero span{display:block;color:transparent;-webkit-text-stroke:2px #111}\nbody.dark .hero span{-webkit-text-stroke:2px #fff}\n@keyframes rise{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:none}}\np{color:#555;line-height:1.6}\nbody.dark p{color:#aab4c5}\n.card{background:#e6e9ef;border-radius:24px;padding:22px;margin:18px 0;box-shadow:8px 8px 20px #c3c9d6,-8px -8px 20px #fff;transition:transform .2s,box-shadow .2s}\n.card:hover{transform:translateY(-4px)}\nbody.dark .card{background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.14);backdrop-filter:blur(18px);box-shadow:0 10px 30px rgba(0,0,0,.4)}\nbutton{border:0;border-radius:16px;padding:13px 22px;font-size:16px;margin:6px 6px 6px 0;background:#fff;color:#111;cursor:pointer;box-shadow:4px 4px 12px #c3c9d6,-4px -4px 12px #fff;font-weight:600}\nbody.dark button{background:rgba(255,255,255,.12);color:#fff;box-shadow:none;border:1px solid rgba(255,255,255,.2)}\nbutton.black{background:#111;color:#fff}\nbody.dark button.black{background:#fff;color:#111}\n.page{display:none}\n.page.active{display:block}\n#n{font-size:56px;font-weight:900;margin:6px 0}\n.small{font-size:13px;color:#777}\nbody.dark .small{color:#8a94a6}\n/* Dark / White button - kept, made bigger and more satisfying */\n.switch{display:flex;align-items:center;gap:16px}\n.track{width:140px;height:64px;border-radius:40px;background:#fff;box-shadow:inset 4px 4px 10px #c3c9d6,inset -4px -4px 10px #fff;position:relative;cursor:pointer;flex-shrink:0}\nbody.dark .track{background:#222;box-shadow:inset 4px 4px 10px #000,inset -4px -4px 10px rgba(255,255,255,.1)}\n.knob{position:absolute;top:7px;left:7px;width:50px;height:50px;border-radius:50%;background:#111;color:#fff;box-shadow:4px 4px 10px #999;display:flex;align-items:center;justify-content:center;font-size:24px;transition:left .35s cubic-bezier(.6,1.6,.4,1)}\nbody.dark .knob{left:83px;background:#fff;color:#111}\n</style>\n</head>\n<body>\n<nav class=\"sidebar\" id=\"side\">\n<button class=\"toggle\" onclick=\"document.getElementById('side').classList.toggle('open')\">\u203a</button>\n<div class=\"logo\">GLASS</div>\n<button class=\"item active\" onclick=\"show('home',this)\"><span class=\"ic\">\u2302</span><span class=\"lbl\">Home</span></button>\n<button class=\"item\" onclick=\"show('post',this)\"><span class=\"ic\">\u270e</span><span class=\"lbl\">Post</span></button>\n<button class=\"item\" onclick=\"show('messages',this)\"><span class=\"ic\">\u2709</span><span class=\"lbl\">Messages</span><span class=\"badge\">2</span></button>\n<button class=\"item\" onclick=\"show('friends',this)\"><span class=\"ic\">\ud83d\udc65</span><span class=\"lbl\">Friends</span></button>\n<button class=\"item\" onclick=\"show('notifications',this)\"><span class=\"ic\">\ud83d\udd14</span><span class=\"lbl\">Notifications</span></button>\n<button class=\"item\" onclick=\"show('group',this)\"><span class=\"ic\">\ud83d\udc6a</span><span class=\"lbl\">Group</span></button>\n<button class=\"item\" onclick=\"show('pages',this)\"><span class=\"ic\">\u25a4</span><span class=\"lbl\">Pages</span></button>\n<button class=\"item\" onclick=\"show('games',this)\"><span class=\"ic\">\ud83c\udfae</span><span class=\"lbl\">Games</span></button>\n<button class=\"item\" onclick=\"show('setting',this)\"><span class=\"ic\">\u2699</span><span class=\"lbl\">Setting</span></button>\n<button class=\"item\" onclick=\"alert('Logged out - demo only')\"><span class=\"ic\">\u23fb</span><span class=\"lbl\">Log Out</span></button>\n</nav>\n<main>\n<section class=\"page active\" id=\"home\">\n<div class=\"hero\">MAKE<br><span>SOMETHING WOW</span></div>\n<p>Black and white only. Big type. Clean sidebar. No clutter. This is the shocking, professional look.</p>\n<div class=\"card switch\">\n<div class=\"track\" onclick=\"document.body.classList.toggle('dark');document.getElementById('knob').textContent=document.body.classList.contains('dark')?'\u263e':'\u2600'\"><div class=\"knob\" id=\"knob\">\u2600</div></div>\n<div><b>Dark / White button</b><p class=\"small\" style=\"margin:4px 0\">Kept, and made bigger. Tap it. Sun = light, Moon = dark.</p></div>\n</div>\n<div class=\"card\">\n<div id=\"n\">0</div>\n<button class=\"black\" onclick=\"document.getElementById('n').textContent=+document.getElementById('n').textContent+1\">+1 Tap me</button>\n<button onclick=\"toast('Hello from Glass App v3')\">Say Hello</button>\n<button onclick=\"vib()\">Vibrate</button>\n<button onclick=\"share('Hello from Glass App v3')\">Share</button>\n</div>\n<div class=\"card\"><b>Test a function</b><p class=\"small\">Real app bridge in the APK, simple alert in a browser.</p>\n<button onclick=\"notifyMe()\">Notify me</button>\n<button onclick=\"speakMe()\">Speak this</button>\n<button onclick=\"saveMe()\">Save a note</button></div>\n</section>\n<section class=\"page\" id=\"post\"><h1>Post</h1><p>Write a short post here in the full version.</p></section>\n<section class=\"page\" id=\"messages\"><h1>Messages</h1><p>You have 2 new messages in this demo.</p></section>\n<section class=\"page\" id=\"friends\"><h1>Friends</h1><p>Your friends list will appear here.</p></section>\n<section class=\"page\" id=\"notifications\"><h1>Notifications</h1><p>Tap Notify me on Home to test a real notification in the APK.</p></section>\n<section class=\"page\" id=\"group\"><h1>Group</h1><p>Your groups will appear here.</p></section>\n<section class=\"page\" id=\"pages\"><h1>Pages</h1><p>Your pages will appear here.</p></section>\n<section class=\"page\" id=\"games\"><h1>Games</h1><p>A simple counter game is on Home.</p></section>\n<section class=\"page\" id=\"setting\"><h1>Setting</h1><p>Black and white only. Light = solid white sidebar + neumorphism. Dark = liquid glass.</p></section>\n</main>\n<script>\nfunction show(id,btn){document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));document.getElementById(id).classList.add('active');document.querySelectorAll('.item').forEach(b=>b.classList.remove('active'));if(btn)btn.classList.add('active')}\nfunction toast(m){if(window.Android&&Android.toast){Android.toast(m)}else{alert(m)}}\nfunction vib(){if(window.Android&&Android.vibrate){Android.vibrate(100)}else{alert('Vibrate works only in the real APK')}}\nfunction share(t){if(window.Android&&Android.share){Android.share(t)}else{alert('Share: '+t)}}\nfunction notifyMe(){if(window.Android&&Android.notify){Android.notify('Glass App v3','Hello, this is a test notification')}else{alert('Notification works only in the real APK')}}\nfunction speakMe(){if(window.Android&&Android.speak){Android.speak('Welcome to Glass App version three')}else{alert('Text to speech works only in the real APK')}}\nfunction saveMe(){if(window.Android&&Android.saveFile){alert(Android.saveFile('glass-note.txt','text/plain','Hello from Glass App v3'))}else{alert('File save works only in the real APK')}}\n</script>\n</body>\n</html>\n"
  },
