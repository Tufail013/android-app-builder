{
 "format": "hab-build-config-1",
 "buildPerformed": false,
 "config": {
  "app": {
   "name": "HTML to APK Converter",
   "pkg": "com.example.converter",
   "vc": "1",
   "vn": "1.0.0",
   "min": "24",
   "target": "34",
   "max": "",
   "scheme": ""
  },
  "src": {
   "type": "file",
   "file": "index.html",
   "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>HTML to APK Converter</title>\n<style>\n*{box-sizing:border-box}\nbody{margin:0;font-family:system-ui,sans-serif;background:#e6e9ef;color:#111;display:flex;min-height:100vh}\nbody.dark{background:#0a0a0a;color:#fff}\n.sidebar{width:76px;flex-shrink:0;background:#fff;padding:16px 10px;display:flex;flex-direction:column;gap:8px;box-shadow:10px 0 30px rgba(0,0,0,.12)}\nbody.dark .sidebar{background:rgba(255,255,255,.07);backdrop-filter:blur(20px);border-right:1px solid rgba(255,255,255,.15);box-shadow:none}\n.sidebar.open{width:230px}\n.toggle{align-self:flex-end;background:#111;color:#fff;border:0;border-radius:50%;width:36px;height:36px;cursor:pointer}\nbody.dark .toggle{background:#fff;color:#111}\n.logo{font-weight:900;padding:12px;white-space:nowrap;overflow:hidden}\n.item{display:flex;align-items:center;gap:12px;padding:13px;border-radius:16px;border:0;background:transparent;color:#111;font-size:16px;text-align:left;cursor:pointer;white-space:nowrap;overflow:hidden}\nbody.dark .item{color:#fff}\n.item.active{background:#111;color:#fff}\nbody.dark .item.active{background:#fff;color:#111}\n.item .ic{min-width:28px;text-align:center;font-size:20px}\n.item .lbl{display:none}\n.sidebar.open .item .lbl{display:inline}\nmain{flex:1;padding:22px;max-width:720px}\nh1{font-size:34px;line-height:1;margin:8px 0}\nh1 span{display:block;color:transparent;-webkit-text-stroke:2px #111}\nbody.dark h1 span{-webkit-text-stroke:2px #fff}\np{color:#555;line-height:1.6}\nbody.dark p{color:#aab4c5}\n.card{background:#e6e9ef;border-radius:24px;padding:20px;margin:16px 0;box-shadow:8px 8px 20px #c3c9d6,-8px -8px 20px #fff}\nbody.dark .card{background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.14);backdrop-filter:blur(18px);box-shadow:none}\ninput,textarea{width:100%;padding:13px;border-radius:14px;border:1px solid #ccc;font-size:16px;margin:8px 0;background:#fff}\nbody.dark input,body.dark textarea{background:#222;color:#fff;border-color:#444}\nbutton{border:0;border-radius:16px;padding:13px 22px;font-size:16px;margin:6px 6px 6px 0;background:#fff;color:#111;cursor:pointer;font-weight:600;box-shadow:4px 4px 12px #c3c9d6,-4px -4px 12px #fff}\nbody.dark button{background:rgba(255,255,255,.12);color:#fff;box-shadow:none;border:1px solid rgba(255,255,255,.2)}\nbutton.black{background:#111;color:#fff}\nbody.dark button.black{background:#fff;color:#111}\n.page{display:none}\n.page.active{display:block}\n.track{width:110px;height:52px;border-radius:30px;background:#fff;box-shadow:inset 3px 3px 8px #c3c9d6;position:relative;cursor:pointer;display:inline-block;vertical-align:middle}\nbody.dark .track{background:#222}\n.knob{position:absolute;top:6px;left:6px;width:40px;height:40px;border-radius:50%;background:#111;color:#fff;display:flex;align-items:center;justify-content:center;transition:left .3s}\nbody.dark .knob{left:64px;background:#fff;color:#111}\n.feat{display:flex;gap:10px;padding:10px 0;border-bottom:1px solid #ddd5}\nbody.dark .feat{border-color:rgba(255,255,255,.1)}\n.feat b{display:block}\n.feat span{font-size:13px;color:#666}\nbody.dark .feat span{color:#999}\n</style>\n</head>\n<body>\n<nav class=\"sidebar\" id=\"side\">\n<button class=\"toggle\" onclick=\"document.getElementById('side').classList.toggle('open')\">\u203a</button>\n<div class=\"logo\">CONVERTER</div>\n<button class=\"item active\" onclick=\"show('convert',this)\"><span class=\"ic\">\u21c4</span><span class=\"lbl\">Convert</span></button>\n<button class=\"item\" onclick=\"show('templates',this)\"><span class=\"ic\">\u25a4</span><span class=\"lbl\">Templates</span></button>\n<button class=\"item\" onclick=\"show('features',this)\"><span class=\"ic\">\u2699</span><span class=\"lbl\">Features</span></button>\n<button class=\"item\" onclick=\"show('myapps',this)\"><span class=\"ic\">\u25a6</span><span class=\"lbl\">My Apps</span></button>\n</nav>\n<main>\n<section class=\"page active\" id=\"convert\">\n<h1>HTML TO APK<br><span>CONVERTER</span></h1>\n<p>This is the converter itself, not a sample app. Put your HTML in, set a name, and build an app from it. Glass design is only the look of this converter.</p>\n<div class=\"card\">\n<b>Step 1 - Your HTML</b>\n<input type=\"file\" id=\"f\" accept=\".html,.htm\" onchange=\"readFile(this)\">\n<textarea id=\"html\" rows=\"6\" placeholder=\"Paste your HTML here, or choose a file above. Example: <h1>Hello</h1>\"></textarea>\n<b>Step 2 - Your app</b>\n<input id=\"name\" placeholder=\"App name, for example My Shop App\" value=\"My HTML App\">\n<input id=\"pkg\" placeholder=\"Package, for example com.example.myshop\" value=\"com.example.myhtmlapp\">\n<button class=\"black\" onclick=\"preview()\">Preview my HTML</button>\n<button onclick=\"downloadConfig()\">Download config.json</button>\n<p id=\"msg\"></p>\n</div>\n<div class=\"card\">\n<b>Dark / White</b>\n<div class=\"track\" onclick=\"document.body.classList.toggle('dark');document.getElementById('knob').textContent=document.body.classList.contains('dark')?'\u263e':'\u2600'\"><div class=\"knob\" id=\"knob\">\u2600</div></div>\n<span style=\"margin-left:10px\">Tap to change the converter look only.</span>\n</div>\n<div class=\"card\" id=\"prev\" style=\"display:none\"><b>Preview</b><div id=\"prevBox\" style=\"border:1px solid #ccc;border-radius:14px;padding:14px;margin-top:10px;background:#fff;color:#111\"></div></div>\n</section>\n<section class=\"page\" id=\"templates\">\n<h1>Templates</h1>\n<p>Start from a template, then change the HTML to your own. These are starting points only, not the final product.</p>\n<div class=\"card\"><b>Shop</b><p>A simple shop page with items and a cart button.</p><button onclick=\"loadTpl('shop')\">Use Shop</button></div>\n<div class=\"card\"><b>Habit Tracker</b><p>Check off a habit each day, with a counter.</p><button onclick=\"loadTpl('habit')\">Use Habit Tracker</button></div>\n<div class=\"card\"><b>Notes</b><p>A simple notes page, saved in the browser.</p><button onclick=\"loadTpl('notes')\">Use Notes</button></div>\n</section>\n<section class=\"page\" id=\"features\">\n<h1>Features, simply</h1>\n<p>Only these work in v1. Others are planned, not fake.</p>\n<div class=\"feat\"><div><b>Toast</b><span>Small message at the bottom. Benefit: quick feedback. Cost: none.</span></div></div>\n<div class=\"feat\"><div><b>Vibrate</b><span>Short buzz. Benefit: feel a tap. Cost: tiny battery.</span></div></div>\n<div class=\"feat\"><div><b>Share</b><span>Send text to another app. Benefit: easy sharing. Cost: none.</span></div></div>\n<div class=\"feat\"><div><b>Notifications</b><span>Message even when the app is closed. Benefit: reminders. Cost: needs permission.</span></div></div>\n<div class=\"feat\"><div><b>File picker / save</b><span>Choose and save a file. Benefit: work with files. Cost: needs permission.</span></div></div>\n<div class=\"feat\"><div><b>Text to speech</b><span>Read text aloud. Benefit: hands-free. Cost: uses speaker.</span></div></div>\n<p>Planned, not in v1 yet: camera, microphone, location, Bluetooth, maps, sensors.</p>\n</section>\n<section class=\"page\" id=\"myapps\">\n<h1>My Apps</h1>\n<p>Apps you built with this converter will be listed here in the full version. For now, each build you make is sent to you as an APK file, like the Glass App v3 was.</p>\n</section>\n</main>\n<script>\nfunction show(id,btn){document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));document.getElementById(id).classList.add('active');document.querySelectorAll('.item').forEach(b=>b.classList.remove('active'));if(btn)btn.classList.add('active')}\nfunction readFile(el){var r=new FileReader();r.onload=function(){document.getElementById('html').value=r.result};r.readAsText(el.files[0])}\nfunction preview(){var h=document.getElementById('html').value;document.getElementById('prev').style.display='block';document.getElementById('prevBox').innerHTML=h||'Paste HTML first.';document.getElementById('msg').textContent='Preview is above. This is how your page will look inside the app.'}\nfunction loadTpl(k){\n var t={shop:'<h1>My Shop</h1><p>Item 1 - Rs 500</p><button onclick=\"alert(\\'Added to cart\\')\">Add to cart</button>',habit:'<h1>My Habits</h1><p>Drink water today</p><button onclick=\"this.textContent=\\'Done \u2713\\'\">Done</button>',notes:'<h1>My Notes</h1><textarea placeholder=\"Write a note\"></textarea>'}[k];\n document.getElementById('html').value=t;show('convert',document.querySelector('.item'));document.getElementById('msg').textContent='Template loaded. Change it, then Preview or Download config.'}\nfunction downloadConfig(){\n var cfg={format:'hab-build-config-1',config:{app:{name:document.getElementById('name').value,pkg:document.getElementById('pkg').value},src:{type:'file',file:'index.html',html:document.getElementById('html').value}}};\n var a=document.createElement('a');a.href=URL.createObjectURL(new Blob([JSON.stringify(cfg)],{type:'application/json'}));a.download='config.json';a.click();\n document.getElementById('msg').textContent='config.json downloaded. In this v1, that config is what GitHub builds into an APK. The next phase is to build the APK inside this app itself, without GitHub.'}\n</script>\n</body>\n</html>\n"
  },
