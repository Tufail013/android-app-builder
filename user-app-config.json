   "file": "index.html",
   "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>TA SERIES — BS Nursing Study Library</title>\n<link rel=\"stylesheet\" href=\"ta.css\">\n</head>\n<body>\n<!-- Top bar -->\n<header class=\"appbar\">\n  <div class=\"appbar-in\">\n    <a class=\"brand\" href=\"https://taseriesofficial.github.io/?app=1\">\n      <span class=\"brand-mark\">TA</span>\n      <span>\n        <span class=\"brand-name\">TA <em>SERIES</em></span>\n        <span class=\"brand-sub\" style=\"display:block\">BS Nursing Academic Platform</span>\n      </span>\n    </a>\n    <span class=\"spacer\"></span>\n    <a class=\"icon-btn\" href=\"https://taseriesofficial.github.io/material.html?app=1\" aria-label=\"Search\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"M20 20l-3.8-3.8\"/></svg>\n    </a>\n    <a class=\"icon-btn\" href=\"https://taseriesofficial.github.io/about.html?app=1\" aria-label=\"About\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\"><path d=\"M4 7h16M4 12h16M4 17h16\"/></svg>\n    </a>\n  </div>\n</header>\n\n<!-- Black hero -->\n<section class=\"hero\">\n  <div class=\"hero-in\">\n    <svg class=\"hero-arcs\" viewBox=\"0 0 210 210\" fill=\"none\" aria-hidden=\"true\">\n      <path d=\"M150 10 C 60 40, 20 120, 40 200\" stroke=\"#C6F432\" stroke-width=\"7\" stroke-linecap=\"round\" opacity=\".9\"/>\n      <path d=\"M185 30 C 110 60, 70 130, 85 195\" stroke=\"#FFFFFF\" stroke-width=\"7\" stroke-linecap=\"round\" opacity=\".85\"/>\n      <path d=\"M205 70 C 150 95, 120 145, 130 190\" stroke=\"#C6F432\" stroke-width=\"5\" stroke-linecap=\"round\" opacity=\".55\"/>\n    </svg>\n    <span class=\"hero-kicker\">Free for BS Nursing students</span>\n    <h1>Your Education,<br><span class=\"lime\">All in One Place.</span></h1>\n    <p>A central academic resource platform for BS Nursing students, bringing together study materials, examination resources and academic tools.</p>\n    <a class=\"hero-cta\" href=\"https://taseriesofficial.github.io/material.html?app=1\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M2 5.5C4 4 7 3.5 9.5 4.5c1.2.5 2 .5 2.5.5s1.3 0 2.5-.5C17 3.5 20 4 22 5.5v13c-2-1.5-5-2-7.5-1-1.2.5-2 .5-2.5.5s-1.3 0-2.5-.5C7 16.5 4 17 2 18.5v-13z\"/><path d=\"M12 5v13\"/></svg>\n      Explore Academic Resources <span class=\"arr\">&rarr;</span>\n    </a>\n    <p class=\"hero-note\">No account needed &middot; Works offline for tests</p>\n  </div>\n</section>\n\n<!-- White stats card -->\n<div class=\"stats-card\">\n  <div class=\"stats-card-in\">\n    <div class=\"stat\">\n      <span class=\"ic\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5z\"/><path d=\"M14 3v5h5\"/><path d=\"M9 13h6M9 17h6\"/></svg></span>\n      <b>1,281+</b><span>Files Available</span>\n    </div>\n    <div class=\"stat\">\n      <span class=\"ic\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 3l9 5-9 5-9-5 9-5z\"/><path d=\"M3 13l9 5 9-5\"/></svg></span>\n      <b>8</b><span>Semesters</span>\n    </div>\n    <div class=\"stat\">\n      <span class=\"ic\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M3 12h18M12 3c2.5 2.6 3.8 5.7 3.8 9S14.5 18.4 12 21c-2.5-2.6-3.8-5.7-3.8-9S9.5 5.6 12 3z\"/></svg></span>\n      <b>5</b><span>Result Regions</span>\n    </div>\n    <div class=\"stat\">\n      <span class=\"ic\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M22 9L12 4 2 9l10 5 10-5z\"/><path d=\"M6 11.5V16c0 1.5 2.7 3 6 3s6-1.5 6-3v-4.5\"/><path d=\"M22 9v5\"/></svg></span>\n      <b>6</b><span>Batches</span>\n    </div>\n  </div>\n</div>\n\n<!-- Connection + update -->\n<div class=\"section\">\n  <span class=\"status-pill\" id=\"net\">Checking connection&hellip;</span>\n  <div class=\"update-banner\" id=\"upd\">\n    <h3>New version available — <span id=\"upd-ver\"></span></h3>\n    <p id=\"upd-notes\"></p>\n    <a class=\"btn btn-lime\" id=\"upd-dl\" href=\"#\">Download the new version</a>\n  </div>\n</div>\n\n<!-- Online -->\n<div class=\"section\">\n  <div class=\"sec-head\"><h2>Online — Study</h2><a class=\"sec-link\" href=\"https://taseriesofficial.github.io/?app=1\">Open website &rarr;</a></div>\n  <a class=\"row\" href=\"https://taseriesofficial.github.io/material.html?app=1\">\n    <span class=\"tile black\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M2 5.5C4 4 7 3.5 9.5 4.5c1.2.5 2 .5 2.5.5s1.3 0 2.5-.5C17 3.5 20 4 22 5.5v13c-2-1.5-5-2-7.5-1-1.2.5-2 .5-2.5.5s-1.3 0-2.5-.5C7 16.5 4 17 2 18.5v-13z\"/><path d=\"M12 5v13\"/></svg></span>\n    <span class=\"body\"><b>Study Materials</b><span>Notes, slides and books by semester</span></span>\n    <span class=\"count\">1,128 files</span><span class=\"chev\">&rsaquo;</span>\n  </a>\n  <a class=\"row\" href=\"https://taseriesofficial.github.io/material.html?app=1#/TA%20SERIES%20Slides%20Book\">\n    <span class=\"tile purple\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 19.5A2.5 2.5 0 0 1 6.5 17H20V3H6.5A2.5 2.5 0 0 0 4 5.5v14z\"/><path d=\"M4 19.5A2.5 2.5 0 0 0 6.5 22H20v-5\"/></svg></span>\n    <span class=\"body\"><b>TA SERIES Slides Book</b><span>Slides books for all semesters, in one place</span></span>\n    <span class=\"count\">36 files</span><span class=\"chev\">&rsaquo;</span>\n  </a>\n  <a class=\"row\" href=\"https://taseriesofficial.github.io/results.html?app=1\">\n    <span class=\"tile amber\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0V4z\"/><path d=\"M7 6H4a2 2 0 0 0 2 4h1M17 6h3a2 2 0 0 1-2 4h-1\"/></svg></span>\n    <span class=\"body\"><b>Examination Results</b><span>Results by region &amp; semester</span></span>\n    <span class=\"count\">144 results</span><span class=\"chev\">&rsaquo;</span>\n  </a>\n  <a class=\"row\" href=\"https://taseriesofficial.github.io/mega.html?app=1\">\n    <span class=\"tile pdf\"><b style=\"font-size:13px\">PDF</b></span>\n    <span class=\"body\"><b>Solved Past Papers / Mega Series</b><span>Past paper books, solved</span></span>\n    <span class=\"count\">9 books</span><span class=\"chev\">&rsaquo;</span>\n  </a>\n</div>\n\n<!-- Offline tests -->\n<div class=\"section\" id=\"tests\">\n  <div class=\"sec-head\"><h2>Offline Tests</h2><span class=\"chip lime\">No internet needed</span></div>\n  <div class=\"card\">\n    <h3>Practice without internet</h3>\n    <p>These mock tests are saved inside the app. Your best scores are saved on this phone.</p>\n    <div style=\"height:14px\"></div>\n    <a class=\"row\" href=\"https://appassets.androidplatform.net/assets/www/quiz-ethics.html\" style=\"box-shadow:none\">\n      <span class=\"tile quiz\"><b style=\"font-size:11px\">QUIZ</b></span>\n      <span class=\"body\"><b>Nursing Ethics</b><span>370 MCQs &middot; 9 chapters &middot; 2017&ndash;2025</span></span>\n      <span class=\"chev\">&rsaquo;</span>\n    </a>\n    <a class=\"row\" href=\"https://appassets.androidplatform.net/assets/www/quiz-psych.html\" style=\"box-shadow:none\">\n      <span class=\"tile quiz\"><b style=\"font-size:11px\">QUIZ</b></span>\n      <span class=\"body\"><b>Applied Developmental Psychology</b><span>490 MCQs &middot; 13 chapters &middot; 2017&ndash;2025</span></span>\n      <span class=\"chev\">&rsaquo;</span>\n    </a>\n  </div>\n</div>\n\n<!-- Tools -->\n<div class=\"section\">\n  <div class=\"sec-head\"><h2>Academic Tools</h2></div>\n  <a class=\"row\" href=\"https://taseriesofficial.github.io/gpa-calculator.html?app=1\">\n    <span class=\"tile tool\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"5\" y=\"3\" width=\"14\" height=\"18\" rx=\"2\"/><path d=\"M8 7h8M8 12h.01M12 12h.01M16 12h.01M8 16h.01M12 16h.01M16 16h.01\"/></svg></span>\n    <span class=\"body\"><b>GPA &amp; CGPA Calculator</b><span>KMU BSN old syllabus &middot; 135 credit hours</span></span>\n    <span class=\"badge tool\">TOOL</span><span class=\"chev\">&rsaquo;</span>\n  </a>\n</div>\n\n<!-- Footer -->\n<p class=\"foot\"><span class=\"ver\" id=\"ver\">App version 1.0.4</span><br>\nFree for BS Nursing students &middot; No account needed<br>\n<a href=\"https://wa.me/923055959410\">WhatsApp +92 305 5959410</a> &middot; <a href=\"mailto:nurseofuture@gmail.com\">nurseofuture@gmail.com</a><br>\nTA SERIES Official &middot; &copy; 2026</p>\n\n<!-- Bottom nav -->\n<nav class=\"bottomnav\"><div class=\"bottomnav-in\">\n  <a class=\"nav-tab active\" href=\"https://appassets.androidplatform.net/assets/www/index.html\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 11l9-8 9 8\"/><path d=\"M5 10v10h14V10\"/></svg>Home</a>\n  <a class=\"nav-tab\" href=\"https://taseriesofficial.github.io/material.html?app=1\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M2 5.5C4 4 7 3.5 9.5 4.5c1.2.5 2 .5 2.5.5s1.3 0 2.5-.5C17 3.5 20 4 22 5.5v13c-2-1.5-5-2-7.5-1-1.2.5-2 .5-2.5.5s-1.3 0-2.5-.5C7 16.5 4 17 2 18.5v-13z\"/><path d=\"M12 5v13\"/></svg>Study</a>\n  <a class=\"nav-tab\" href=\"#tests\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 11l3 3L22 4\"/><path d=\"M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11\"/></svg>Tests</a>\n  <a class=\"nav-tab\" href=\"https://taseriesofficial.github.io/?app=1\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M3 12h18M12 3c2.5 2.6 3.8 5.7 3.8 9S14.5 18.4 12 21c-2.5-2.6-3.8-5.7-3.8-9S9.5 5.6 12 3z\"/></svg>Website</a>\n</div></nav>\n\n<script>\n(function(){\n  var el=document.getElementById('net');\n  function set(){\n    var on=false;\n    try{ on = (window.Android && Android.isOnline) ? Android.isOnline() : navigator.onLine; }catch(e){ on=navigator.onLine; }\n    el.textContent = on ? 'Online' : 'Offline — tests still work';\n    el.classList.toggle('off', !on);\n  }\n  set();\n  window.addEventListener('online', set);\n  window.addEventListener('offline', set);\n})();\n</script>\n<script>\n(function(){\n  // Update check: ask the website which app version is the newest. If a\n  // newer one exists, show the banner above. No Play Store needed — the new\n  // version downloads from the TA SERIES website itself.\n  // The installed version code comes from the app itself when available,\n  // so this check can never drift from the real version.\n  var CURRENT_VC = 5; // update this number on every release (matches versionCode in the config)\n  try{\n    if(window.Android && Android.versionCode){ var vc = Android.versionCode(); if(vc) CURRENT_VC = vc; }\n  }catch(e){}\n  try{\n    fetch('https://taseriesofficial.github.io/app-version.json',{cache:'no-store'})\n      .then(function(r){ return r.json(); })\n      .then(function(v){\n        if(v && v.versionCode && v.versionCode > CURRENT_VC && v.apkUrl){\n          document.getElementById('upd-ver').textContent = 'Version ' + v.version;\n          document.getElementById('upd-notes').textContent = v.notes || '';\n          document.getElementById('upd-dl').href = v.apkUrl;\n          document.getElementById('upd').classList.add('show');\n        }\n      })\n      .catch(function(){});\n  }catch(e){}\n  try{\n    var v = '';\n    if(window.Android && Android.appVersion) v = Android.appVersion();\n    document.getElementById('ver').textContent = v ? ('App version ' + v) : 'App version 1.0.4';\n  }catch(e){ document.getElementById('ver').textContent = 'App version 1.0.4'; }\n})();\n</script>\n<script>\n// TA SERIES back handling: on the home screen there is nowhere to go back\n// to, so the phone back button asks before exiting the app.\nwindow.taBack = function(){ return false; };\n</script>\n</body>\n</html>\n"
