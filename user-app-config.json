   "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<meta name=\"color-scheme\" content=\"light\">\n<title>TA SERIES \u2014 BS Nursing Study Library</title>\n<link rel=\"stylesheet\" href=\"ta.css\">\n</head>\n<body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\"><defs>\n<symbol id=\"fold\" viewBox=\"0 0 48 40\"><path d=\"M3 8a4 4 0 0 1 4-4h10l4 4h20a4 4 0 0 1 4 4v22a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4z\" fill=\"currentColor\" opacity=\".72\"/><path d=\"M3 15a4 4 0 0 1 4-4h34a4 4 0 0 1 4 4v19a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4z\" fill=\"currentColor\"/><path d=\"M3 15a4 4 0 0 1 4-4h34a4 4 0 0 1 4 4v6H3z\" fill=\"#fff\" opacity=\".28\"/></symbol>\n</defs></svg>\n\n<!-- Top bar -->\n<header class=\"appbar\">\n  <div class=\"appbar-in\">\n    <a class=\"brand\" href=\"https://taseriesofficial.github.io/?app=1\">\n      <span class=\"brand-mark\">TA</span>\n      <span>\n        <span class=\"brand-name\">TA <em>SERIES</em></span>\n        <span class=\"brand-sub\" style=\"display:block\">Nursing study hub</span>\n      </span>\n    </a>\n    <span class=\"spacer\"></span>\n    <span class=\"chip\" id=\"net\"><span class=\"dot\"></span>Online</span>\n    <a class=\"icon-btn\" href=\"https://taseriesofficial.github.io/?app=1\" aria-label=\"Open website\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M3 12h18M12 3c2.5 2.6 3.8 5.7 3.8 9S14.5 18.4 12 21c-2.5-2.6-3.8-5.7-3.8-9S9.5 5.6 12 3z\"/></svg>\n    </a>\n  </div>\n</header>\n\n<div class=\"wrap\">\n  <!-- Update banner (Home only) -->\n  <div class=\"update-banner\" id=\"upd\">\n    <h3>New version available \u2014 <span id=\"upd-ver\"></span></h3>\n    <p id=\"upd-notes\"></p>\n    <a class=\"btn btn-teal\" id=\"upd-dl\" href=\"#\">Download the new version</a>\n  </div>\n\n  <!-- Sunken search: opens the website material search -->\n  <form class=\"searchbox sunk\" id=\"searchForm\" role=\"search\">\n    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"M20 20l-3.8-3.8\"/></svg>\n    <input id=\"searchInput\" type=\"search\" placeholder=\"Search 1,281+ files\" aria-label=\"Search study files\" autocomplete=\"off\">\n  </form>\n\n  <!-- 2x2 tiles -->\n  <div class=\"tiles\">\n    <a class=\"tile raise\" href=\"https://taseriesofficial.github.io/material.html?app=1\">\n      <span class=\"fold-ic\" style=\"color:#E0A030\"><svg aria-hidden=\"true\"><use href=\"#fold\"/></svg></span>\n      <b class=\"t\">Study Material</b>\n      <span class=\"m\">1,128 files</span>\n    </a>\n    <a class=\"tile raise\" href=\"#tests\">\n      <span class=\"big\" style=\"color:#0E7C86\">MCQ</span>\n      <b class=\"t\">Offline Tests</b>\n      <span class=\"m\">860 MCQs</span>\n    </a>\n    <a class=\"tile raise\" href=\"https://taseriesofficial.github.io/results.html?app=1\">\n      <span class=\"big\" style=\"color:#3C6FB0\">Res</span>\n      <b class=\"t\">Exam Results</b>\n      <span class=\"m\">144 files</span>\n    </a>\n    <a class=\"tile raise\" href=\"https://taseriesofficial.github.io/mega.html?app=1\">\n      <span class=\"big\" style=\"color:#B5543C\">PDF</span>\n      <b class=\"t\">Past Paper Books</b>\n      <span class=\"m\">9 books</span>\n    </a>\n  </div>\n\n  <!-- GPA tile -->\n  <a class=\"rowbtn raise\" href=\"https://taseriesofficial.github.io/gpa-calculator.html?app=1\" style=\"margin-top:14px\">\n    <span class=\"gpabadge\">GPA</span>\n    <span class=\"grow\"><span class=\"rowtitle\">GPA &amp; CGPA Calculator</span><br><span class=\"m\">Marks saved per semester</span></span>\n    <span class=\"chev\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m9 6 6 6-6 6\"/></svg></span>\n  </a>\n\n  <!-- Offline tests -->\n  <div class=\"section\" id=\"tests\" style=\"padding:0;margin-top:26px\">\n    <div class=\"sec-head\" style=\"margin-top:0\"><h2>Offline Tests</h2><span class=\"chip\">No internet needed</span></div>\n    <div class=\"card\">\n      <h3>Practice without internet</h3>\n      <p>These mock tests are saved inside the app. Your best scores are saved on this phone.</p>\n      <div style=\"height:14px\"></div>\n      <a class=\"row\" href=\"https://appassets.androidplatform.net/assets/www/quiz-ethics.html\" style=\"box-shadow:none\">\n        <span class=\"tile quiz\"><b style=\"font-size:11px\">QUIZ</b></span>\n        <span class=\"body\"><b>Nursing Ethics</b><span>370 MCQs &middot; 9 chapters &middot; 2017&ndash;2025</span></span>\n        <span class=\"chev\">&rsaquo;</span>\n      </a>\n      <a class=\"row\" href=\"https://appassets.androidplatform.net/assets/www/quiz-psych.html\" style=\"box-shadow:none\">\n        <span class=\"tile quiz\"><b style=\"font-size:11px\">QUIZ</b></span>\n        <span class=\"body\"><b>Applied Developmental Psychology</b><span>490 MCQs &middot; 13 chapters &middot; 2017&ndash;2025</span></span>\n        <span class=\"chev\">&rsaquo;</span>\n      </a>\n    </div>\n  </div>\n\n  <!-- Footer -->\n  <p class=\"foot\"><span class=\"ver\" id=\"ver\">App version 1.0.5</span><br>\n  Free for BS Nursing students &middot; No account needed<br>\n  <a href=\"https://wa.me/923055959410\">WhatsApp +92 305 5959410</a> &middot; <a href=\"mailto:nurseofuture@gmail.com\">nurseofuture@gmail.com</a><br>\n  TA SERIES Official &middot; &copy; 2026</p>\n</div>\n\n<!-- Bottom nav: Home, Study, Tests, Tools -->\n<nav class=\"bottomnav\"><div class=\"bottomnav-in\">\n  <a class=\"nav-tab active\" href=\"https://appassets.androidplatform.net/assets/www/index.html\"><span class=\"ni\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 10.5 12 3l9 7.5\"/><path d=\"M5 9.5V21h14V9.5\"/><path d=\"M9.5 21v-6h5v6\"/></svg></span>Home</a>\n  <a class=\"nav-tab\" href=\"https://taseriesofficial.github.io/material.html?app=1\"><span class=\"ni\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 19.5A2.5 2.5 0 0 1 6.5 17H20V3H6.5A2.5 2.5 0 0 0 4 5.5z\"/><path d=\"M4 19.5A2.5 2.5 0 0 0 6.5 22H20v-5\"/></svg></span>Study</a>\n  <a class=\"nav-tab\" href=\"#tests\"><span class=\"ni\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 20h9\"/><path d=\"M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z\"/></svg></span>Tests</a>\n  <a class=\"nav-tab\" href=\"https://taseriesofficial.github.io/tools.html?app=1\"><span class=\"ni\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M19.4 15a1.7 1.7 0 0 0 .34 1.87l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.7 1.7 0 0 0-1.87-.34 1.7 1.7 0 0 0-1 1.55V21a2 2 0 1 1-4 0v-.09a1.7 1.7 0 0 0-1-1.55 1.7 1.7 0 0 0-1.87.34l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.7 1.7 0 0 0 .34-1.87 1.7 1.7 0 0 0-1.55-1H3a2 2 0 1 1 0-4h.09a1.7 1.7 0 0 0 1.55-1 1.7 1.7 0 0 0-.34-1.87l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.7 1.7 0 0 0 1.87.34h0a1.7 1.7 0 0 0 1-1.55V3a2 2 0 1 1 4 0v.09a1.7 1.7 0 0 0 1 1.55h0a1.7 1.7 0 0 0 1.87-.34l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.7 1.7 0 0 0-.34 1.87v0a1.7 1.7 0 0 0 1.55 1H21a2 2 0 1 1 0 4h-.09a1.7 1.7 0 0 0-1.55 1z\"/></svg></span>Tools</a>\n</div></nav>\n\n<script>\n(function(){\n  var el=document.getElementById('net');\n  function set(){\n    var on=false;\n    try{ on = (window.Android && Android.isOnline) ? Android.isOnline() : navigator.onLine; }catch(e){ on=navigator.onLine; }\n    el.innerHTML = on ? '<span class=\"dot\"></span>Online' : '<span class=\"dot\"></span>Offline';\n    el.classList.toggle('off', !on);\n  }\n  set();\n  window.addEventListener('online', set);\n  window.addEventListener('offline', set);\n})();\n</script>\n<script>\n(function(){\n  // Search opens the website material search.\n  document.getElementById('searchForm').addEventListener('submit', function(e){\n    e.preventDefault();\n    location.href = 'https://taseriesofficial.github.io/material.html?app=1';\n  });\n})();\n</script>\n<script>\n(function(){\n  // Update check: ask the website which app version is the newest. If a\n  // newer one exists, show the banner above. No Play Store needed \u2014 the new\n  // version downloads from the TA SERIES website itself.\n  // The installed version code comes from the app itself when available,\n  // so this check can never drift from the real version.\n  var CURRENT_VC = 6; // update this number on every release (matches versionCode in the config)\n  try{\n    if(window.Android && Android.versionCode){ var vc = Android.versionCode(); if(vc) CURRENT_VC = vc; }\n  }catch(e){}\n  try{\n    fetch('https://taseriesofficial.github.io/app-version.json',{cache:'no-store'})\n      .then(function(r){ return r.json(); })\n      .then(function(v){\n        if(v && v.versionCode && v.versionCode > CURRENT_VC && v.apkUrl){\n          document.getElementById('upd-ver').textContent = 'Version ' + v.version;\n          document.getElementById('upd-notes').textContent = v.notes || '';\n          document.getElementById('upd-dl').href = v.apkUrl;\n          document.getElementById('upd').classList.add('show');\n        }\n      })\n      .catch(function(){});\n  }catch(e){}\n  try{\n    var v = '';\n    if(window.Android && Android.appVersion) v = Android.appVersion();\n    document.getElementById('ver').textContent = v ? ('App version ' + v) : 'App version 1.0.5';\n  }catch(e){ document.getElementById('ver').textContent = 'App version 1.0.5'; }\n})();\n</script>\n<script>\n// TA SERIES back handling: on the home screen there is nowhere to go back\n// to, so the phone back button is handled by the app itself \u2014 it shows a\n// \"Press back again to exit\" toast (see MainActivity.handleBack).\nwindow.taBack = function(){ return false; };\n</script>\n</body>\n</html>\n"
