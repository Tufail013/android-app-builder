   "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>TA SERIES \u2014 BS Nursing Study Library</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap\" rel=\"stylesheet\">\n<style>\n*{box-sizing:border-box}\nbody{margin:0;font-family:Inter,system-ui,-apple-system,'Segoe UI',sans-serif;background:#F7FAFF;color:#101D3A}\n.wrap{max-width:720px;margin:0 auto;padding:16px 16px 32px}\nheader{display:flex;align-items:center;gap:12px;padding:8px 0 4px}\n.mark{width:44px;height:44px;border-radius:12px;background:#7A1233;color:#fff;display:grid;place-items:center;font-weight:800;font-size:19px;flex:none}\nh1{font-size:20px;margin:0;letter-spacing:.02em}\nh1 span{color:#7A1233}\n.sub{color:#53627D;font-size:13px;margin:2px 0 0}\n.status{display:inline-block;margin-top:12px;padding:5px 10px;border-radius:999px;background:#E7ECF7;color:#101D3A;font-size:12px;font-weight:600}\n.status.off{background:#FBE9EE;color:#7A1233}\n.stats{display:flex;gap:8px;margin:16px 0}\n.stat{flex:1;background:#fff;border:1px solid #DCE4F2;border-radius:14px;padding:12px 6px;text-align:center}\n.stat b{display:block;font-size:18px;color:#7A1233}\n.stat span{font-size:11px;color:#53627D}\n.card{background:#fff;border:1px solid #DCE4F2;border-radius:18px;padding:18px;margin:14px 0}\n.card h2{margin:0 0 6px;font-size:18px}\n.card p{margin:0 0 14px;color:#53627D;font-size:14px;line-height:1.55}\n.btn{display:block;width:100%;text-align:center;text-decoration:none;border-radius:14px;padding:14px;font-size:16px;font-weight:700}\n.btn-burg{background:#7A1233;color:#fff}\n.btn-ghost{background:#EEF4FF;color:#101D3A;margin-top:8px}\n.quiz{display:flex;align-items:center;gap:12px;background:#F7FAFF;border:1px solid #DCE4F2;border-radius:14px;padding:12px;margin-top:10px;text-decoration:none;color:#101D3A}\n.quiz .ico{width:40px;height:40px;border-radius:10px;background:#101D3A;color:#fff;display:grid;place-items:center;font-weight:800;font-size:14px;flex:none}\n.quiz b{display:block;font-size:15px}\n.quiz span{font-size:12px;color:#53627D}\n.quiz .go{margin-left:auto;color:#7A1233;font-weight:800;font-size:20px}\n.foot{text-align:center;color:#53627D;font-size:12px;line-height:1.7;margin-top:20px}\n.foot a{color:#7A1233;font-weight:600;text-decoration:none}\n</style>\n</head>\n<body>\n<div class=\"wrap\">\n  <header>\n    <div class=\"mark\">TA</div>\n    <div>\n      <h1>TA <span>SERIES</span></h1>\n      <p class=\"sub\">BS Nursing Study Library \u2014 Free</p>\n    </div>\n  </header>\n  <span class=\"status\" id=\"net\">Checking connection\u2026</span>\n  <div class=\"card\" id=\"upd\" style=\"display:none;border-color:#7A1233\">\n    <h2>New version available \u2014 <span id=\"upd-ver\"></span></h2>\n    <p id=\"upd-notes\"></p>\n    <a class=\"btn btn-burg\" id=\"upd-dl\" href=\"#\">Download the new version</a>\n  </div>\n  <div class=\"stats\">\n    <div class=\"stat\"><b>1,281+</b><span>Files</span></div>\n    <div class=\"stat\"><b>144</b><span>Results</span></div>\n    <div class=\"stat\"><b>9</b><span>Books</span></div>\n    <div class=\"stat\"><b>860</b><span>MCQs</span></div>\n  </div>\n\n  <section class=\"card\">\n    <h2>Online \u2014 Browse the website</h2>\n    <p>Study materials, examination results, books and tools, organised by semester. Needs internet. Files open inside this app, and downloads save to your phone's Downloads folder.</p>\n    <a class=\"btn btn-burg\" href=\"https://taseriesofficial.github.io/\">Open TA SERIES Website</a>\n    <a class=\"btn btn-ghost\" href=\"https://taseriesofficial.github.io/gpa-calculator.html\">GPA &amp; CGPA Calculator</a>\n    <a class=\"btn btn-ghost\" href=\"https://taseriesofficial.github.io/results.html\">Examination Results</a>\n    <a class=\"btn btn-ghost\" href=\"https://taseriesofficial.github.io/material.html\">Study Materials</a>\n  </section>\n\n  <section class=\"card\">\n    <h2>Offline Tests \u2014 Practice without internet</h2>\n    <p>These mock tests are saved inside the app. No internet needed. Your best scores are saved on this phone.</p>\n    <a class=\"quiz\" href=\"https://appassets.androidplatform.net/assets/www/quiz-ethics.html\">\n      <span class=\"ico\">NE</span>\n      <span><b>Nursing Ethics</b><span>370 MCQs \u00b7 9 chapters \u00b7 2017\u20132025</span></span>\n      <span class=\"go\">\u203a</span>\n    </a>\n    <a class=\"quiz\" href=\"https://appassets.androidplatform.net/assets/www/quiz-psych.html\">\n      <span class=\"ico\">AP</span>\n      <span><b>Applied Developmental Psychology</b><span>490 MCQs \u00b7 13 chapters \u00b7 2017\u20132025</span></span>\n      <span class=\"go\">\u203a</span>\n    </a>\n  </section>\n\n  <p class=\"foot\"><span id=\"ver\">App version 1.0.3</span><br>Free for BS Nursing students \u00b7 No account needed<br>\n  <a href=\"https://wa.me/923055959410\">WhatsApp +92 305 5959410</a> \u00b7 <a href=\"mailto:nurseofuture@gmail.com\">nurseofuture@gmail.com</a><br>\n  TA SERIES Official \u00b7 \u00a9 2026</p>\n</div>\n<script>\n(function(){\n  var el=document.getElementById('net');\n  function set(){\n    var on=false;\n    try{ on = (window.Android && Android.isOnline) ? Android.isOnline() : navigator.onLine; }catch(e){ on=navigator.onLine; }\n    el.textContent = on ? 'Online' : 'Offline \u2014 tests still work';\n    el.classList.toggle('off', !on);\n  }\n  set();\n  window.addEventListener('online', set);\n  window.addEventListener('offline', set);\n})();\n</script>\n<script>\n(function(){\n  // Update check: ask the website which app version is the newest. If a\n  // newer one exists, show the banner above. No Play Store needed \u2014 the new\n  // version downloads from the TA SERIES website itself.\n  var CURRENT_VC = 4; // update this number on every release (matches versionCode in the config)\n  try{\n    fetch('https://taseriesofficial.github.io/app-version.json',{cache:'no-store'})\n      .then(function(r){ return r.json(); })\n      .then(function(v){\n        if(v && v.versionCode && v.versionCode > CURRENT_VC && v.apkUrl){\n          document.getElementById('upd-ver').textContent = 'Version ' + v.version;\n          document.getElementById('upd-notes').textContent = v.notes || '';\n          document.getElementById('upd-dl').href = v.apkUrl;\n          document.getElementById('upd').style.display = 'block';\n        }\n      })\n      .catch(function(){});\n  }catch(e){}\n  try{\n    var v = '';\n    if(window.Android && Android.appVersion) v = Android.appVersion();\n    document.getElementById('ver').textContent = v ? ('App version ' + v) : 'App version 1.0.3';\n  }catch(e){ document.getElementById('ver').textContent = 'App version 1.0.3'; }\n})();\n</script>\n</body>\n</html>\n"
